# 03 order-dependent DECIDE handler
# defect: two DECIDE handlers registered by the execution vote in a way that depends on the order they run in
# caught by: the phase-shuffle observer run (testObserver: plain against phase-shuffled traces)
#
--- a/src/vm/execution.c
+++ b/src/vm/execution.c
@@ -449,6 +449,34 @@
   }
 }
 
+static int planted_a_ran;
+
+static void planted_a(GRCORE_Context * context, void * value, GRCORE_PollCall * call) {
+  (void)context;
+  (void)value;
+  (void)call;
+  planted_a_ran = 1;
+}
+
+static void planted_b(GRCORE_Context * context, void * value, GRCORE_PollCall * call) {
+  (void)context;
+  (void)value;
+  if (!planted_a_ran) {
+    (void)grcore_pollcall_vote(call, GRCORE_VERDICT_PAUSE);
+  }
+}
+
+static void planted_reset(GRCORE_Context * context, void * value, GRCORE_PollCall * call) {
+  (void)context;
+  (void)value;
+  (void)call;
+  planted_a_ran = 0;
+}
