# 197 the template policy's discard limit is off by one
# defect: the benchmark harness's template policy (want_template) expects a TPL_COUNTED template to be entered nine times
#   before it is discarded, not eight
# caught by: bench --smoke --only steady-template-float-label-compiled-warm-call (check_jit_expectation: entries and counted exits exactly)
#
--- a/bench/bench.c
+++ b/bench/bench.c
@@ -448,7 +448,7 @@
       want.counted = top;
       break;
     case TPL_COUNTED: {
-      const int64_t entered = compiled < 8 ? compiled : 8;
+      const int64_t entered = compiled < 9 ? compiled : 9;
       want.entries = entered + top;
       want.counted = entered + top;
       want.discarded = compiled >= 8 ? 1 : 0;
