# caught by: the foreign-ref test (testDescription)
#
--- a/src/vm/description.c
+++ b/src/vm/description.c
@@ -321,7 +321,7 @@
 // ---------------------------------------------------------------------------
 
 static bool valid_ref(const GLTANG_ValueDescription * d, GLTANG_ValueRef ref) {
-  return ref.index > 0 && ref.index < d->node_used && ref.owner == d->owner;
+  return ref.index > 0 && ref.index < d->node_used; /* planted: the owner is not compared */
 }
 
