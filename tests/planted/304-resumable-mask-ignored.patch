# 304 the operation a callback is entered for is not what the mask is asked about
# defect: every operation of a type is asked about as its `add`, so a type that lists one operation lets all of them ask
# caught by: the opaque-callback misuse test (testCustom_reentry)
#
--- a/src/vm/custom.c
+++ b/src/vm/custom.c
@@ -514,7 +514,7 @@
   // What decides whether this callback may ask for a guest call (gltang_call_guest): the type's list. The attribute
   // of a built-in kind has no type, and never may.
   call.owner = oc->type;
-  call.op = (uint8_t)oc->op;
+  call.op = (uint8_t)GLTANG_TYPE_OP_ADD;
   bool made = true;
   for (size_t i = 0; i < oc->argc && made; ++i) {
     made = gltang_call_arg(&call, i, &h[i]) == GLTANG_OK;
