# 174 the compiled attribute of a value does not stand while it runs
# defect: the value `ATTR` helper does not say that its operation stands, so a poll inside a long
#   retag or render writes no identity and reads whatever the guest frame was left with
# caught by: the long operations test, its retag and render of 20480 bytes, which compares the
#   identity of every poll with the interpreter's (testJit_templates, JitTemplates.ALongConcatenation*)
#
--- a/src/jit/natives.c
+++ b/src/jit/natives.c
@@ -292,8 +292,7 @@
   GLTANG_Execution * exec = execution_from(context, execution);
   exec->pending_fuel += gltang_opcode_cost_table[GLTANG_OP_ATTR];
   ++exec->jit_stats.value_calls;
-  // A retag (`.html` and the others) and `.render` poll inside, at the `ATTR`.
-  exec->standing = true;
+  /* planted: the attribute does not stand */
   GLTANG_Value result = attribute(exec, container, constant);
   exec->standing = false;
   return finished(exec, result, false);
