# 39 the pop hook does not give back the callee's extension
# defect: a returned compiled call leaves its extension of the reservation in
# place, so the capacity grows with every call and never comes back until the
# entry gives it all back at its exit
# caught by: the capacity at the caller's polls, which is the caller's own
# however many calls have returned (testJit_floats)
#
--- a/src/jit/hooks.c
+++ b/src/jit/hooks.c
@@ -167,7 +167,7 @@ static void hook_pop(void * context) {
   const uint64_t callee = grcore_stack_frame_count(stack) ? grcore_stack_slots(stack, grcore_stack_top(stack))[GLTANG_F_FUNCTION] : 0;
   (void)grcore_stack_pop(stack);
   if (exec->jit) {
-    gltang_jit_retract_level(exec, exec->jit->chain, callee);
+    (void)callee;
     if (exec->jit->chain) {
       --exec->jit->chain;
     }
