# 182 a compiled ADOPT does not copy the container it stores
# defect: the ADOPT helper hands back the container itself, so a literal that stores a variable's
#   array holds that array, and a later change through the variable is seen through the literal
# caught by: the literals in a loop, whose held row must not show the caller's later change
#   (testJit_templates, JitTemplates.LiteralsInALoop*)
#
--- a/src/jit/natives.c
+++ b/src/jit/natives.c
@@ -339,7 +339,7 @@
   exec->pending_fuel += gltang_opcode_cost_table[GLTANG_OP_ADOPT];
   ++exec->jit_stats.value_calls;
   exec->standing = true;
-  GLTANG_Value result = gltang_vm_op_adopt(exec, value);
+  GLTANG_Value result = value;  /* planted: the stored container is not copied */
   exec->standing = false;
   return finished(exec, result, false);
 }
