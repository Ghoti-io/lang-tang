# 120 a refused print kept in the buffer
# defect: when the sink refuses a print the print is not rolled back, so the buffer holds text the print's value says failed
# caught by: the refusal test (testHost_context)
#
--- a/src/vm/text.c
+++ b/src/vm/text.c
@@ -667,8 +667,7 @@
     return st != GLTANG_ST_OK ? gltang_vm_failure_value(exec, st) : gltang_vm_make_error(exec, GLTANG_ERROR_RECURSION_LIMIT);
   }
   if (!output_deliver(exec)) {
-    output_rollback(exec->out);
-    return gltang_vm_make_error(exec, GLTANG_ERROR_HOST_FAILED);
+    return gltang_vm_make_error(exec, GLTANG_ERROR_HOST_FAILED); /* planted: no rollback */
   }
   exec->out->committed = exec->out->length;
   return GLTANG_V_NULL;
