# 33 a subnormal flushed to zero
# defect: a compiled float product or quotient that is subnormal is replaced by zero of
# the same sign, as a compiled operation run with flush-to-zero set would. Both print as
# 0., so only the slot's bits differ. (Story 7 moved this from the interpreter's
# arithmetic into the compiled emission itself.)
# caught by: the frame differential's bits channel, interpreter against JIT (testObserver)
#
--- a/src/jit/build.c
+++ b/src/jit/build.c
@@ -1524,6 +1524,15 @@
         }
         GRJIT_OpKind fk = op == GLTANG_OP_ADD ? GRJIT_OP_FADD : op == GLTANG_OP_SUB ? GRJIT_OP_FSUB : op == GLTANG_OP_MUL ? GRJIT_OP_FMUL : GRJIT_OP_FDIV;
         B(grjit_builder_binary(c->b, fk, c->stack_f[d - 2u], V(fa), V(fb)));
+        if (fk == GRJIT_OP_FMUL || fk == GRJIT_OP_FDIV) {
+          /* planted: a result below the smallest normal is multiplied by 0.0 */
+          GRJIT_VReg r = c->stack_f[d - 2u];
+          B(grjit_builder_unary(c->b, GRJIT_OP_FABS, c->tmp_f[0], V(r)));
+          cmp(c, GRJIT_CMP_LT, t[TMP_C], V(c->tmp_f[0]), FI(2.2250738585072014e-308));
+          bin(c, GRJIT_OP_XOR, t[TMP_C], V(t[TMP_C]), I(1));
+          B(grjit_builder_unary(c->b, GRJIT_OP_CONVERT_S, c->tmp_f[1], V(t[TMP_C])));
+          B(grjit_builder_binary(c->b, GRJIT_OP_FMUL, r, V(r), V(c->tmp_f[1])));
+        }
         add_fuel(c, cost);
         break;
       }
