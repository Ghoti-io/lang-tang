# 188 the fold of a constant cast to int takes 2^59 (the fold's twin of 52)
# defect: constant_cast's upper bound is inclusive, so 2^59, which is no small integer, is folded
#   (into a wrong word) instead of exiting to the interpreter's boxed integer
# caught by: the constant casts at both bounds, against the interpreter
#   (testJit_templates, JitTemplates.ACastToIntOfAFloatConstant*)
#
--- a/src/jit/build.c
+++ b/src/jit/build.c
@@ -362,7 +362,7 @@
   uint64_t u = (uint64_t)bits;
   memcpy(&v, &u, sizeof(v));
   // The bounds trunc_small guards: [-2^59, 2^59). A NaN fails both.
-  if (!(v >= -0x1p59 && v < 0x1p59)) {
+  if (!(v >= -0x1p59 && v <= 0x1p59)) {  /* planted: 2^59 folded */
     return CAST_FOLD_OUT;
   }
   *out = (int64_t)v;
