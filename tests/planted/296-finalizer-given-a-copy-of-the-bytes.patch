# 296 the finalizer is given a copy of the bytes
# defect: the destroy hook copies the raw bytes to its frame and hands the finalizer the copy, not the instance's bytes in place
# caught by: the in-place test (the finalizer's pointer is the one a callback reached) (testCustom_collector)
#
--- a/src/vm/custom.c
+++ b/src/vm/custom.c
@@ -207,7 +207,9 @@
   // touched, and nothing is allocated in the heap. The instance's ID is already forgotten.
   GLTANG_CustomObject * custom = payload;
   const GLTANG_Type * type = custom->type;
-  type->descriptor.finalizer(type->descriptor.user, gltang_custom_bytes(custom), type->descriptor.byte_count);
+  unsigned char copy[64] = {0}; /* planted */
+  memcpy(copy, gltang_custom_bytes(custom), type->descriptor.byte_count < sizeof copy ? type->descriptor.byte_count : sizeof copy);
+  type->descriptor.finalizer(type->descriptor.user, copy, type->descriptor.byte_count);
   // Last: the registry holds the type, its descriptor and the module the finalizer is in. This can be the last
   // reference, which frees the registry with the process allocator it was made with.
   gltang_type_registry_release((GLTANG_TypeRegistry *)(uintptr_t)type->registry);
