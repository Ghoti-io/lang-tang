# 373 a weak slot emptied with null still reads as having had a target
# defect: storing null keeps the cell's had-target flag, so the emptied slot reads as cleared
# caught by: the never-set test (an emptied slot is not cleared) (testCustom_collector)
#
--- a/src/vm/handle.c
+++ b/src/vm/handle.c
@@ -804,7 +804,7 @@
   if (cell) {
     // Null empties it: "never set" again, not "cleared".
     (void)grheap_store_word(exec->heap, cell, &cell->target, v);
-    cell->flags = flags;
+    cell->flags |= flags; /* planted */
     return GLTANG_OK;
   }
   if (v == GLTANG_V_NULL) {
