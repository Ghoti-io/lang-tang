# 67 every extension is recorded, whatever its size
# defect: the extension helper records a callee that extends the reservation by
# nothing, so every compiled call grows and shrinks the record array like a call
# whose callee holds floats
# caught by: the float-free call test, which counts the records across fib(15)
# (testJit_floats)
#
#
--- a/src/jit/boxes.c
+++ b/src/jit/boxes.c
@@ -98,9 +98,6 @@ static bool pool_top_up(GLTANG_Execution * exec, GLTANG_Jit * jit, size_t want)
 }
 
