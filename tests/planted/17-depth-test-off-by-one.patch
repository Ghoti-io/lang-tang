# 17 the depth test off by one
# defect: the push hook refuses a call one level before the guest-depth limit
# instead of at it, so compiled recursion exits at a call the interpreter's
# would make (the verdict is the same, as the interpreter then makes the call;
# the number of compiled calls is not)
# caught by: the recursion-limit test, which counts the compiled calls (testJit_calls)
#
--- a/src/jit/hooks.c
+++ b/src/jit/hooks.c
@@ -90,7 +90,7 @@ static uint32_t hook_push(void * context, uint64_t callee, const uint64_t * args
   // push is the frame-push GC point. Neither fires the memory budget's
   // CALL_REFUSED poll: the interpreter makes the call after the exit and fires it
   // once.
-  if (grcore_context_depth(context, GRCORE_DEPTH_GUEST) >= grcore_context_guest_depth(context)) {
+  if (grcore_context_depth(context, GRCORE_DEPTH_GUEST) + 1u >= grcore_context_guest_depth(context)) {  /* planted: one too soon */
     return refuse_push(jit);
   }
