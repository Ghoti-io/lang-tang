# 227 a raw float's concatenation with a string puts the float on the wrong side
# defect: emit_concat_float tells the thunk the float is first when it is second, and second when it is first
# caught by: the prints, concatenations and casts of the special values, their text against the interpreter's
#   (testJit_templates, JitTemplates.ARawFloatsPrintConcatenation*)
#
--- a/src/jit/build.c
+++ b/src/jit/build.c
@@ -1914,7 +1914,7 @@
  */
 static void emit_concat_float(Ctx * c, uint32_t i, uint32_t d, uint32_t spos) {
   const uint32_t fpos = spos == d - 2u ? d - 1u : d - 2u;
-  GRJIT_Operand args[3] = {V(c->stack[spos]), float_bits_of(c, fpos), I(fpos < spos ? 1 : 0)};
+  GRJIT_Operand args[3] = {V(c->stack[spos]), float_bits_of(c, fpos), I(fpos < spos ? 0 : 1)};  /* planted: the sides swapped */
   emit_native_state(c, i, d, GLTANG_JIT_NATIVE_CONCAT_FLOAT, args, 3, c->stack[d - 2u], d - 1u, true, d - 2u);
 }
 
