# 176 the slow path of a compiled `+` tests only its left operand for a host-defined value
# defect: gltang_jit_operands_custom (the one test of both operands before `+`'s slow path, story 4e)
#   tests the left operand and not the right, so `"x" + m` with m a host-defined value is given to the
#   helper instead of leaving before the operation
# caught by: the host-defined operand of each value operation, its "right of +" row: exact counted
#   exits and helper calls (testJit_templates, JitTemplates.AHostDefinedOperand*)
#
--- a/src/jit/helpers.c
+++ b/src/jit/helpers.c
@@ -62,7 +62,8 @@
 }
 
 uint64_t gltang_jit_operands_custom(GLTANG_Execution * exec, uint64_t a, uint64_t b) {
-  if (gltang_v_is_custom(a) || gltang_v_is_custom(b)) {
+  (void)b;
+  if (gltang_v_is_custom(a) /* planted: the right operand is not tested */) {
     exec->jit->refusal = GLTANG_REFUSAL_OPERAND_GUARD;
     return 1;
   }
