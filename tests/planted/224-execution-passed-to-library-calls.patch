# 224 compiled code passes the execution to a library call's thunk too
# defect: emit_native_at prepends the execution (story 4e, for the template ops' thunks, which take
#   it first) to the arguments of every native, the library calls' included, whose thunks take the
#   callee first and have no room for it (fifteen arguments and the callee are runtime-jit's limit)
# caught by: the natives of every arity called from compiled code (testNative_calls,
#   NativeCalls.ANativeOfEveryArity*)
#
--- a/src/jit/build.c
+++ b/src/jit/build.c
@@ -1561,7 +1561,7 @@
   fill_state(c, c->state2, i + 1u, after_depth);
   GRJIT_FrameState before = {identity_at(c, i), c->slots, c->state};
   GRJIT_FrameState after = {identity_at(c, i), c->slots, c->state2};
-  if (id >= GLTANG_JIT_NATIVE_USE) {
+  if (id != GLTANG_JIT_NATIVE_COUNT) {  /* planted: every native */
     // A template op's thunk takes the execution first (natives.c, execution_from).
     GRJIT_Operand with_execution[8];
     assert(argc + 1u <= sizeof(with_execution) / sizeof(with_execution[0]) && "a template op's native takes at most seven arguments");
