# 155 a compiled print does not store where it is before the call
# defect: `emit_native` stores the instruction's position (the interpreter's SYNC) for every native but the two prints
# caught by: the refused delivery, whose error must name the print's line as its origin (testJit_templates)
#
--- a/src/jit/build.c
+++ b/src/jit/build.c
@@ -1323,7 +1323,9 @@
  * operands. Everything pending is charged first, since the native may observe it.
  */
 static void emit_native(Ctx * c, uint32_t i, uint32_t d, uint32_t id, const GRJIT_Operand * args, size_t argc, GRJIT_VReg dst, uint32_t after_depth) {
-  emit_site(c, i);
+  if (id < GLTANG_JIT_NATIVE_PRINT) {  /* planted: the prints do not store their position */
+    emit_site(c, i);
+  }
   flush_cost(c);
   fill_state(c, c->state, i, d);
   fill_state(c, c->state2, i + 1u, after_depth);
