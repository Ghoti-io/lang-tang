# 16 the push hook omits the CALL's fuel
# defect: the CALL instruction's cost is never added, by the hook or by anything
# else, so a compiled call is free and the fuel total and the poll at which a
# budget runs out are the interpreter's no longer
# caught by: the fuel-parity tests (testJit_calls)
#
--- a/src/jit/hooks.c
+++ b/src/jit/hooks.c
@@ -116,7 +116,7 @@
   }
   (void)grcore_stack_set_identity(stack, frame, (GRCORE_PollIdentity){callee, 0});
   // The CALL's own fuel, now that the call is made.
-  exec->pending_fuel += gltang_opcode_cost_table[GLTANG_OP_CALL];
+  /* planted: the CALL's fuel is not added */
   ++exec->jit_stats.calls;
   if (++jit->chain > exec->jit_stats.deepest_chain) {
     exec->jit_stats.deepest_chain = jit->chain;
