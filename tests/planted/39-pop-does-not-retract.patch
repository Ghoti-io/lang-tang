# 39 the pop hook does not give back the callee's extension
# defect: a returned compiled call leaves its extension of the reservation in
# place, so the capacity grows with every call and never comes back until the
# entry gives it all back at its exit
# caught by: the capacity at the caller's polls, which is the caller's own
# however many calls have returned (testJit_floats)
#
--- a/src/jit/hooks.c
+++ b/src/jit/hooks.c
@@ -192,7 +192,7 @@ static void hook_pop(void * context) {
   if (jit && jit->ext_count > jit->ext_floor && jit->ext[jit->ext_count - 1u].level == jit->chain) {
     const uint64_t callee = grcore_stack_slots(stack, grcore_stack_top(stack))[GLTANG_F_FUNCTION];
     assert(jit->ext[jit->ext_count - 1u].fword == callee);
-    gltang_jit_retract_level(exec, jit->chain, callee);
+    (void)callee;  /* planted: the extension is not given back */
   }
   (void)grcore_stack_pop(stack);
   if (jit && jit->chain) {
