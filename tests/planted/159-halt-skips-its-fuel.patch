# 159 the compiled HALT charges no fuel
# defect: the emission of `HALT` returns the halted word without adding the operation's cost
# caught by: the warm template and every template and script test whose fuel is compared with the interpreter's (testJit_templates)
#
--- a/src/jit/build.c
+++ b/src/jit/build.c
@@ -1861,7 +1861,7 @@
       // returned word goes to the entry's result buffer (`grjit_code_call`'s `out`), which is
       // no root, and never into a compiled caller's register, since function 0 is never a
       // compiled callee (no `FUNC 0` names it).
-      add_fuel(c, cost);
+      /* planted: HALT's cost is not charged */
       flush_cost(c);
       B(grjit_builder_const(c->b, c->halted, (int64_t)gltang_jit_halted_word(i)));
       B(grjit_builder_ret(c->b, V(c->halted)));
