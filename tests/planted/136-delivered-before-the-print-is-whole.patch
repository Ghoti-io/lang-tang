# 136 a print delivered before it is known to be whole
# defect: the sink is given the print's bytes before the engine has checked the print finished, so a print that then fails is rolled back out of the buffer after the sink has it
# caught by: the failing-print sweep (testHost_context)
#
--- a/src/vm/text.c
+++ b/src/vm/text.c
@@ -722,6 +722,7 @@
   gltang_sink_init(&sink, GLTANG_SINK_OUTPUT, exec);
   bool too_deep = false;
   GLTANG_Status st = gltang_vm_render(&sink, v, GLTANG_RENDER_PRINT, 0, &too_deep);
+  (void)output_deliver(exec); /* planted: delivered before it is known to be whole */
   return print_finish(exec, st, too_deep);
 }
 
