# 23 the call passes the entry flag as 1
# defect: a compiled call tells the callee that the entry poll has been made, and
# the hook (which here accepts either flag) lets it through, so the callee skips
# its entry poll and the polls of a compiled run are fewer than the interpreter's
# caught by: the entry-form parity test, the poll count (testJit_calls)
#
--- a/src/jit/build.c
+++ b/src/jit/build.c
@@ -1260,3 +1260,3 @@
   }
-  args[n] = I(0);
+  args[n] = I(1);  /* planted: 0 */
   fill_state(c, c->state2, i + 1u, at);
--- a/src/jit/hooks.c
+++ b/src/jit/hooks.c
@@ -110,6 +110,6 @@
   const GLTANG_Function * cf = function_of(exec, callee);
-  if (!cf || result_count != 1u || result_count != expected_result_count(jit, callee) ||
-      count != (uint64_t)cf->parameter_count + 1u || !args || args[count - 1u] != 0u) {
+  if (!cf || result_count != 1u || result_count != expected_result_count(jit, callee) ||
+      count != (uint64_t)cf->parameter_count + 1u || !args) {  /* planted: the flag is not checked */
     ++exec->jit_stats.hook_argument_errors;
     return refuse_push(jit);
   }
