# 153 a compiled print leaves its operand in place of its value
# defect: the result of the `PRINT` helper is discarded, so the operand slot keeps the printed value instead of null
# caught by: the loop of prints, whose function returns the last print's value (testJit_templates)
#
--- a/src/jit/build.c
+++ b/src/jit/build.c
@@ -1851,7 +1851,7 @@
   emit_fast_call(c, i, (uint64_t)(uintptr_t)gltang_jit_print_fast, args, 1);
   branch_fast_or_slow(c, V(c->tmp[TMP_R]), &fast, &slow);
   new_block(c, &join);
-  emit_native_at(c, i, d, GLTANG_JIT_NATIVE_PRINT, args, 1, c->stack[d - 1u], d, false);
+  emit_native_at(c, i, d, GLTANG_JIT_NATIVE_PRINT, args, 1, GRJIT_NO_VREG, d, false);  /* planted: the value is not the result */
   branch_to(c, join);
   set_block(c, fast);
   B(grjit_builder_const(c->b, c->stack[d - 1u], (int64_t)GLTANG_V_NULL));
