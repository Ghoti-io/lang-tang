# 156 the interpreter's frame does not stand at a print while the print runs
# defect: `PRINT` and `PRINT_CONST` neither record their position in the frame nor stand, so a poll
#   inside a long print (its pacing) writes no identity and sees another frame than compiled code's
#   call of the same print shows
# caught by: the frame differential over the output programs, interpreter against JIT (testObserver)
#
--- a/src/vm/interp.c
+++ b/src/vm/interp.c
@@ -1174,9 +1174,7 @@
       case GLTANG_OP_PRINT: {
         // A long print polls inside (its pacing): the frame there stands at the print,
         // the state and identity compiled code's call of the same function carries.
-        SYNC();
-        SAVE_AT_OP();
-        STAND_AT_OP();
+        SYNC();  /* planted: the frame is not stood at the print */
         GLTANG_Value r;
         if (gltang_v_is_custom(S[sp - 1u])) {
           exec->suspend_mode = 1;
@@ -1196,9 +1194,7 @@
       }
 
       case GLTANG_OP_PRINT_CONST: {
-        SYNC();
-        SAVE_AT_OP();
-        STAND_AT_OP();
+        SYNC();  /* planted: the frame is not stood at the print */
         GLTANG_Value r = gltang_vm_print_constant(exec, program->constants[a].block);
         STOOD();
         if (r == GLTANG_V_UNWIND) {
