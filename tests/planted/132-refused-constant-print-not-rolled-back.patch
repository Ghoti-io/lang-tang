# 132 a refused print of text kept in the buffer
# defect: when the sink refuses a print of a constant (the text of a template) the print is not rolled back, so the buffer holds text the print's value says failed
# caught by: the template refusal test (testHost_context)
#
--- a/src/vm/text.c
+++ b/src/vm/text.c
@@ -680,8 +680,7 @@
   GLTANG_Status st = sink_block(&sink, s);
   if (st == GLTANG_ST_OK) {
     if (!output_deliver(exec)) {
-      output_rollback(exec->out);
-      return gltang_vm_make_error(exec, GLTANG_ERROR_HOST_FAILED);
+      return gltang_vm_make_error(exec, GLTANG_ERROR_HOST_FAILED); /* planted: no rollback */
     }
     exec->out->committed = exec->out->length;
     return GLTANG_V_NULL;
