# 257 a host attribute that wins over a built-in name
# defect: the string arm of the attribute rule asks the registries first, so a registered `html` or `length` hides the built-in one
# caught by: the built-in-name-wins test (testCustom_ops)
#
--- a/src/vm/ops.c
+++ b/src/vm/ops.c
@@ -654,6 +654,13 @@
 static GLTANG_Value attr(GLTANG_Execution * exec, GLTANG_Value container, const char * name, size_t length, GLTANG_Value name_value) {
   switch (gltang_vm_kind(container)) {
     case GLTANG_KIND_STRING:
+      {
+        bool found;
+        GLTANG_Value host = gltang_vm_host_attribute(exec, container, name, length, &found); /* planted: before the built-in names */
+        if (found) {
+          return host;
+        }
+      }
       if (name_is(name, length, "length")) {
         return gltang_vm_make_int(exec, (int64_t)gltang_vm_string(container)->grapheme_length);
       }
