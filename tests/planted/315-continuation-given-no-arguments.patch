# 315 the continuation's call object has no arguments
# defect: a map continuation has lost the function it is mapping
# caught by: the map, sort and operation tests (testCustom_reentry)
#
--- a/src/vm/custom.c
+++ b/src/vm/custom.c
@@ -511,7 +511,7 @@
   memset(&call, 0, GLTANG_CALL_ZEROED);
   call.exec = exec;
   call.args = held;
-  call.argc = oc->argc;
+  call.argc = continuing ? 0u : oc->argc;
   // What decides whether this callback may ask for a guest call (gltang_call_guest): the type's list. The attribute
   // of a built-in kind has no type, and never may.
   call.owner = oc->type;
