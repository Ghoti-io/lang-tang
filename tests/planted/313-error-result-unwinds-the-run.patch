# 313 a callee that cannot be entered ends the run
# defect: the error value of a callee refused for its arguments is taken for an unwind, so the continuation is not called
# caught by: the callee-that-cannot-be-entered test (testCustom_reentry)
#
--- a/src/vm/interp.c
+++ b/src/vm/interp.c
@@ -224,7 +224,7 @@
       else {
         value = gltang_vm_make_error(exec, GLTANG_ERROR_INVALID_FUNCTION_CALL);
       }
-      if (value == GLTANG_V_UNWIND) {
+      if (value == GLTANG_V_UNWIND || gltang_vm_is_error(value)) {
         if (exec->request_made) {
           continue;  // the call asked for another: its record is the innermost, and chains to this one
         }
