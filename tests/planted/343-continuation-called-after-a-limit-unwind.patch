# 343 a record whose callee went with a template's unwound frames is given the limit error
# defect: the template's budget unwind delivers its limit error to the innermost record of the frames it removed, so a continuation runs for a callee that never returned
# caught by: the template-budget-inside-a-chain test (the bound native's continuation count) (testCustom_reentry)
#
--- a/src/vm/interp.c
+++ b/src/vm/interp.c
@@ -1362,8 +1362,8 @@
       exec->resume_active = false;
       while (exec->pending_top) {
         const GLTANG_PendingObject * record = gltang_object(exec->pending_top);
-        if (record->frame < stopped->call_frame) {
-          to_record = record->callee_frame == stopped->call_frame;
+        if (record->frame < stopped->call_frame || record->callee_frame > stopped->call_frame) {
+          to_record = record->callee_frame >= stopped->call_frame;
           break;
         }
         gltang_vm_pending_pop(exec);
