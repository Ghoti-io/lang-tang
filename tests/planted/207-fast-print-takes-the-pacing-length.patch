# 207 the fast path takes a print of the pacing interval's own length
# defect: the fast path's bound is `length > GLTANG_POLL_BYTES`, so a string of exactly GLTANG_POLL_BYTES bytes is
#   copied by it, without the poll the interpreter's print makes inside at its end
# caught by: f's loop printing, from its parameters, a string one byte short of the interval and one of its length
#   (PRINT of a value, which compiled code tests only when it runs): once the output has room the longer one is the
#   fast path, and expect_same finds a poll fewer than the interpreter's (testJit_templates,
#   JitTemplates.ATextThatDoesNotFitTheOutput*)
#
--- a/src/vm/text.c
+++ b/src/vm/text.c
@@ -728,7 +728,7 @@
 /** The copy of a print of one run of `length` bytes tagged `type`, if nothing else would happen. */
 static bool print_run_fast(GLTANG_Execution * exec, const char * bytes, size_t length, GLTANG_String_Type type) {
   GLTANG_OutBuf * out = exec->out;
-  if (length >= GLTANG_POLL_BYTES || output_delivers(exec) || !out->segment_count
+  if (length > GLTANG_POLL_BYTES /* planted: the bound inclusive */ || output_delivers(exec) || !out->segment_count
       || out->segments[out->segment_count - 1u].type != type || out->length + length + 1u > out->capacity) {
     return false;
   }
