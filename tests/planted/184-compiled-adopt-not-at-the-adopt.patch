# 184 the compiled ADOPT does not stand while it copies
# defect: the ADOPT helper does not say that its operation stands, so a poll inside a long deep copy
#   writes no identity and reads whatever the guest frame was left with (the twin of 185, which is
#   the interpreter's)
# caught by: the copying ADOPT of a large array, which compares the identity of every poll with the
#   interpreter's (testJit_templates, JitTemplates.ACastToStringOfALargeArray*)
#
--- a/src/jit/natives.c
+++ b/src/jit/natives.c
@@ -355,7 +355,7 @@
   GLTANG_Execution * exec = execution_from(context, execution);
   exec->pending_fuel += gltang_opcode_cost_table[GLTANG_OP_ADOPT];
   ++exec->jit_stats.value_calls;
-  exec->standing = true;
+  /* planted: the ADOPT does not stand */
   GLTANG_Value result = gltang_vm_op_adopt(exec, value);
   exec->standing = false;
   return finished(exec, result, false);
