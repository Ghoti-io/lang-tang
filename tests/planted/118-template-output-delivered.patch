# 118 a template call's own output delivered to the sink
# defect: the delivery does not check that the buffer is the main activation's, so what a template prints reaches the sink as it is printed and again as part of the print that uses its value
# caught by: the template output test (testHost_context)
#
--- a/src/vm/text.c
+++ b/src/vm/text.c
@@ -629,7 +629,7 @@
 
 /** Whether a print that finishes is handed to the host's sink: only the main activation's output is. */
 static bool output_delivers(const GLTANG_Execution * exec) {
-  return exec->sink && exec->out == &exec->main_act.out;
+  return exec->sink != NULL; /* planted: any activation's output */
 }
 
