# 155 a compiled print does not store where it is before the call
# defect: `emit_native` stores the instruction's position (the interpreter's SYNC) for every native but the two prints
# caught by: the refused delivery, whose error must name the print's line as its origin, and the large print,
#   which compares the identity of every poll (testJit_templates)
#
--- a/src/jit/build.c
+++ b/src/jit/build.c
@@ -1451,7 +1451,7 @@
  * the interpreter's does only sometimes (a string constant, made on first use).
  */
 static void emit_native_at(Ctx * c, uint32_t i, uint32_t d, uint32_t id, const GRJIT_Operand * args, size_t argc, GRJIT_VReg dst, uint32_t after_depth, bool site) {
-  if (site) {
+  if (site && id != GLTANG_JIT_NATIVE_PRINT && id != GLTANG_JIT_NATIVE_PRINT_CONST) {  /* planted: the prints do not store their position */
     emit_site(c, i);
   }
   flush_cost(c);
