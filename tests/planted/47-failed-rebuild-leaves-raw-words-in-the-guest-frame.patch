# 47 a failed rebuild leaves raw words in the guest frame
# defect: before the rebuild the deopt hook copies the compiled frame's words, raw
# doubles included, into the guest frame's slots, which the injected failure then
# leaves there for the unwind (the story's "raw slot written before its conversion
# finished", realised with the failing-rebuild seam)
# caught by: the failed-rebuild test, whose seam checks the value slots of the
# guest frames the failed rebuild left for any word that looks like an object and is
# not in the heap (testJit_floats). A collection cannot see it: a guest frame paired
# with a compiled frame is not scanned until its record is rebuilt.
#
--- a/src/jit/hooks.c
+++ b/src/jit/hooks.c
@@ -377,6 +377,30 @@
           }
         }
       }
+      if (jit->test_fail_rebuild) {
+        /* planted: every frame's words, raw ones too, go into its guest slots first */
+        GRCORE_CompiledWalk planted_walk;
+        GRCORE_CompiledFrame pf;
+        GRCORE_FrameRef g = grcore_stack_top(stack);
+        size_t g_idx = frame_count - 1u;
+        if (grcore_compiled_walk_begin(context, &planted_walk) == GRCORE_OK) {
+          while (grcore_compiled_walk_next(&planted_walk, &pf) == GRCORE_CWALK_FRAME && pf.record == fr.record) {
+            const size_t pidx = pf.base_frames - 1u + (pf.run_length - 1u - pf.run_depth);
+            while (g_idx > pidx) {
+              g = grcore_stack_caller(stack, g);
+              --g_idx;
+            }
+            uint64_t planted_words[GLTANG_JIT_MAX_SLOTS];
+            if (pf.site && pf.site->frame_state_count <= GLTANG_JIT_MAX_SLOTS &&
+                grcore_deopt_read(pf.site, (const void *)pf.frame_base, planted_words, pf.site->frame_state_count) == GRCORE_OK) {
+              uint64_t * guest_slots = grcore_stack_slots(stack, g);
+              for (size_t w = 0; w < pf.site->frame_state_count; ++w) {
+                guest_slots[w] = planted_words[w];
+              }
+            }
+          }
+        }
+      }
     }
   }
   jit->refusal = GLTANG_REFUSAL_NONE;
