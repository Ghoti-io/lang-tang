# 01 missing root
# defect: the execution does not report its temporaries (values held across a GC point) to the collector
# caught by: the torture suite (GRHEAP_TORTURE=1 GRHEAP_VERIFY=1 over testExecute_complex)
#
--- a/src/vm/execution.c
+++ b/src/vm/execution.c
@@ -430,9 +430,7 @@
   for (size_t i = 0; i < exec->root_count; ++i) {
     visitor->slot(visitor->user, &exec->roots[i]);
   }
-  for (size_t i = 0; i < exec->temp_count; ++i) {
-    visitor->slot(visitor->user, &exec->temps[i]);
-  }
+  /* planted: the temporaries are no longer reported as roots */
   // The innermost pending record (a guest call a host callback asked for), which holds the rest.
   visitor->slot(visitor->user, &exec->pending_top);
 #ifdef GLTANG_WITH_JIT
