# 168 the attribute helper does not hold its operand across the allocation of the name
# defect: compiled code's `ATTR` makes the name from its constant (a GC point) and then reads the
#   attribute of its own C copy of the container, not the one held in the temporaries, so a
#   collection that moves the container leaves it reading the old address
# caught by: the template of attributes, elements and concatenations, under relocation torture,
#   and by nothing else: the container is in the call's frame state, so a collector that does not
#   move keeps it alive where it was (testJit_templates, GRHEAP_RELOCATE+TORTURE)
#
--- a/src/jit/natives.c
+++ b/src/jit/natives.c
@@ -143,7 +143,7 @@
     return exec->roots[GLTANG_ROOT_OOM];
   }
   GLTANG_Value name = gltang_vm_constant(exec, (uint32_t)constant);
-  container = gltang_vm_temp_at(exec, mark);
+  /* planted: the container is not read again from the temporaries */
   if (name == GLTANG_V_UNWIND) {
     gltang_vm_temp_release(exec, mark);
     return name;
