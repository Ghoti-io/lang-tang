# 348 the innermost pending record is not a root
# defect: the execution does not report `pending_top` to the collector: the record, and everything it holds, is collected while its callee runs
# caught by: the tests that force torture on themselves (testCustom_reentry)
#
--- a/src/vm/execution.c
+++ b/src/vm/execution.c
@@ -434,7 +434,6 @@
     visitor->slot(visitor->user, &exec->temps[i]);
   }
   // The innermost pending record (a guest call a host callback asked for), which holds the rest.
-  visitor->slot(visitor->user, &exec->pending_top);
 #ifdef GLTANG_WITH_JIT
   // The float boxes made ahead of time for the rebuild's conversions.
   gltang_jit_enumerate_roots(exec, visitor);
