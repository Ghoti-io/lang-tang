# 280 a weak cell's target is written without the barrier
# defect: the first store into a weak slot writes the cell's target with a plain assignment, which barrier-verify sees
# caught by: barrier-verify in the forced torture arm of the weak-slot tests (testCustom_collector)
#
--- a/src/vm/custom.c
+++ b/src/vm/custom.c
@@ -229,7 +229,7 @@
   cell->kind = GLTANG_OBJ_WEAK;
   cell->flags = flags;
   // The weak slot is a slot of a heap object: written through the barrier.
-  (void)grheap_store_word(exec->heap, cell, &cell->target, gltang_vm_temp_at(exec, mark));
+  cell->target = gltang_vm_temp_at(exec, mark); /* planted */
   gltang_vm_temp_release(exec, mark);
   GLTANG_HandleState * hs = exec->handles;
   if (hs && !hs->weak_owner) {
