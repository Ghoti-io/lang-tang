# 69 the steady-state cases expect the answer for n + 1 and the fresh-engine cases do not
# defect: the steady-state cases expect the answer for n + 1 and the fresh-engine cases do not; the benchmark harness's own check (steady_run_x's check: only the steady selection can see it)
# caught by: bench --smoke --only steady-float-cmp
#
--- a/bench/bench.c
+++ b/bench/bench.c
@@ -1040,7 +1040,7 @@
       "i = 0; while (i < %llu) { r = f(%llu); i = i + 1; } tick(); r;",
       p->source, (unsigned long long)n, (unsigned long long)(which == 0 ? 0u : float_warm()), (unsigned long long)n,
       (unsigned long long)(which == 0 ? 0u : float_timed()), (unsigned long long)n);
-  set_expectations(p, n);
+  set_expectations(p, n + 1u);
   /* A function that returns a float exits at every return, and the eighth exit discards it; the
    * integer-returning programs exit nowhere. */
   const uint64_t calls = which == 0 ? 1u : 1u + float_warm() + float_timed();
