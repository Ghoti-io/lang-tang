# 183 the interpreter's frame does not stand at a cast to string while it runs
# defect: the interpreter's CAST records no position and does not stand before a cast to string, so a
#   poll inside a long rendering writes no identity, where compiled code's helper stands at the cast
#   (the twin of 181; only the JIT arm sees it)
# caught by: the cast to string of a large array, the identity of every poll
#   (testJit_templates, JitTemplates.ACastToStringOfALargeArray*)
#
--- a/src/vm/interp.c
+++ b/src/vm/interp.c
@@ -799,13 +799,7 @@
       case GLTANG_OP_CAST: {
         GLTANG_Value v = S[sp - 1u];
         SYNC();
-        if (a == GLTANG_CAST_TYPE_STRING || gltang_v_is_custom(v)) {
-          // A cast to string renders its operand, paced by the bytes it renders, and a cast of a
-          // host-defined value runs its type's callback, which may poll: stand at the cast, as
-          // compiled code's helper does. The other casts of other values poll nowhere and stand nowhere.
-          SAVE_AT_OP();
-          STAND_AT_OP();
-        }
+        /* planted: the interpreter does not stand at a cast to string */
         GLTANG_Value r;
         if (gltang_v_is_custom(v)) {
           exec->suspend_mode = 1;
