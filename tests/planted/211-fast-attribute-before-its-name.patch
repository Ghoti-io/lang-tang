# 211 the fast path of a map's attribute reads by a name that has not been made
# defect: the fast path does not require the name constant to be made already, so the attribute's first read is the
#   fast path and the string the interpreter's `ATTR` makes for its name is never made
# caught by: the loop of a map's attribute, whose heap objects are compared with the interpreter's
#   (testJit_templates, JitTemplates.AMapsAttributeIsTheFastPath*)
#
--- a/src/vm/ops.c
+++ b/src/vm/ops.c
@@ -664,7 +664,7 @@
  * (the slow path allocates it), and a missing key (null by the slow path). No allocation, no poll.
  */
 GLTANG_Value gltang_vm_map_attr_fast(const GLTANG_Execution * exec, GLTANG_Value container, uint32_t index, const char * name, size_t length, uint64_t hash) {
-  if (!gltang_v_is_kind(container, GLTANG_OBJ_MAP) || !exec->constants[index]) {
+  if (!gltang_v_is_kind(container, GLTANG_OBJ_MAP) || (!exec->constants[index] && 0) /* planted: the name need not be made */) {
     return GLTANG_V_UNWIND;
   }
   bool found;
