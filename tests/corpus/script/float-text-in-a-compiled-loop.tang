function show(a, label, m) { x = a * 1.0; s = ""; i = 0; while (i < 2) { print(x); print(" "); print("v=" + x); print(" "); print(x + "=v"); print(" "); print(label + x); print(" "); print(x + label); print(" "); print(m.name + x); print(" "); s = s + "" + x + (x as string); i = i + 1; } print(s); print("\n"); return 0; }
big = 99999999999999999999999.0; inf = big * big; inf = inf * inf; inf = inf * inf; inf = inf * inf; inf = inf * inf;
m = {name: "n"}; vals = [0.0, -0.0, 1.5, -2.25, 3.0, 0.1, 1000000000000000.0, big, inf, 0.0 - inf, 0.0000004];
k = 0; while (k < 11) { show(vals[k], "l:", m); k = k + 1; }
k;
