# 333 a template callee stopped by its own budget is not the callee's value
# defect: the limit error is pushed for the instruction and the pending record is left behind
# caught by: the template-callee-limit test (testCustom_reentry)
#
--- a/src/vm/interp.c
+++ b/src/vm/interp.c
@@ -1363,7 +1363,7 @@
       while (exec->pending_top) {
         const GLTANG_PendingObject * record = gltang_object(exec->pending_top);
         if (record->frame < stopped->call_frame) {
-          to_record = record->callee_frame == stopped->call_frame;
+          to_record = false;
           break;
         }
         gltang_vm_pending_pop(exec);
