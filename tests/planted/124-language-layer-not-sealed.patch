# caught by: the readable-layer test (testHost_context)
#
--- a/src/library/language.c
+++ b/src/library/language.c
@@ -48,7 +48,7 @@
 }
 
 GLTANG_Result gltang_language_set_library(GLTANG_Library * library) {
