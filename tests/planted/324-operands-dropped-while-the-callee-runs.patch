# 324 the suspended instruction's top operand is dropped from the stack
# defect: the stack pointer saved for the caller's frame is one too low, so the instruction finds its operands wrong when it runs again
# caught by: the matrix and operation tests (testCustom_reentry)
#
--- a/src/vm/interp.c
+++ b/src/vm/interp.c
@@ -276,7 +276,7 @@
   GRCORE_Stack * stack = grcore_context_stack(context);
   uint64_t * S = grcore_stack_slots(stack, grcore_stack_top(stack));
   S[GLTANG_F_PC] = exec->current_offset;
-  S[GLTANG_F_SP] = sp;
+  S[GLTANG_F_SP] = sp - 1u;
   return pending_step(exec, context, GLTANG_V_NULL, false);
 }
 
