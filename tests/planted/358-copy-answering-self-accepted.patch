# 358 a `copy` that answers `self` is accepted
# defect: the copy stored is the original, so the value type is shared
# caught by: the copy-operation test (testCustom_collector)
#
--- a/src/vm/custom.c
+++ b/src/vm/custom.c
@@ -1170,7 +1170,8 @@
   }
   // A new instance of its own type, and not `self`: anything else would store the original, or a value of another
   // type, where a copy was asked for.
-  if (!gltang_v_is_custom(r) || gltang_vm_custom(r)->type != type || r == self) {
+  if (!gltang_v_is_custom(r) || gltang_vm_custom(r)->type != type) { /* planted */
+    (void)self;
     return MAKE_ERROR(GLTANG_ERROR_HOST_FAILED);
   }
   return r;
