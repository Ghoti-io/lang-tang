# 199 a compiled text still stands after its call has returned
# defect: the `PRINT_CONST` helper does not clear `exec->standing`, so the next runtime poll outside a
#   standing operation writes the frame's identity at whatever `current_offset` holds, where the
#   interpreter writes nothing
# caught by: the large-print test's third program, whose template ends with a text after an HTML string (the thunk,
#   not story 4d's fast path), which leaves the stand set: the polls of the template's output string, built by
#   HALT's body, then read an identity the interpreter's do not (testJit_templates, JitTemplates.ALargePrint*)
#
--- a/src/jit/natives.c
+++ b/src/jit/natives.c
@@ -203,7 +203,7 @@
   exec->standing = true;
   // The interpreter's PRINT_CONST keeps nothing of the value but an unwind.
   GLTANG_Value result = gltang_vm_print_constant(exec, (const GLTANG_StringBlock *)(uintptr_t)block);
-  exec->standing = false;
+  /* planted: the text still stands after its call */
   return finished(exec, result, false);
 }
 
