# 15 the push hook reads its arguments before the push
# defect: the hook copies the arguments out of the call site's argument area
# before it pushes the callee's frame, and writes those copies into the frame
# after the push (which is a GC point under torture): a collection that moves an
# object updates the area, not the copy, so the callee gets a stale reference
# caught by: the relocation arm (GRHEAP_RELOCATE=1 over testJit_calls: a callee whose entry fails the native stack check is run by the interpreter from the frame the push made); invisible without relocation
#
--- a/src/jit/hooks.c
+++ b/src/jit/hooks.c
@@ -101,6 +101,11 @@ static uint32_t hook_push(void * context, uint64_t callee, const uint64_t * args
   }
   GRCORE_Stack * stack = grcore_context_stack(context);
   GRCORE_FrameRef frame;
+  /* planted: the arguments are read before the push */
+  uint64_t planted_early[GLTANG_JIT_MAX_CALL_ARGS + 1u];
+  for (uint32_t i = 0; i < cf->parameter_count; ++i) {
+    planted_early[i] = args[i];
+  }
   if (grcore_stack_push(stack, exec->engine, cf->frame_slots, &frame) != GRCORE_OK) {
     gltang_jit_retract_level(exec, jit->chain + 1u);
     return refuse_push(jit);
@@ -125,7 +130,7 @@ static uint32_t hook_push(void * context, uint64_t callee, const uint64_t * args
