# 153 a compiled print leaves its operand in place of its value
# defect: the result of the `PRINT` helper is discarded, so the operand slot keeps the printed value instead of null
# caught by: the loop of prints, whose function returns the last print's value (testJit_templates)
#
--- a/src/jit/build.c
+++ b/src/jit/build.c
@@ -1386,7 +1386,7 @@
  */
 static void emit_print(Ctx * c, uint32_t i, uint32_t d) {
   GRJIT_Operand args[1] = {V(c->stack[d - 1u])};
-  emit_native(c, i, d, GLTANG_JIT_NATIVE_PRINT, args, 1, c->stack[d - 1u], d);
+  emit_native(c, i, d, GLTANG_JIT_NATIVE_PRINT, args, 1, GRJIT_NO_VREG, d);  /* planted: the value is not the result */
 }
 
 /** `PRINT_CONST k`: the interpreter's print of the constant's text; it pushes nothing, and its value is discarded as the interpreter discards it. */
