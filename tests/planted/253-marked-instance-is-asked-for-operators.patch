# 253 an instance that stands for an error is asked for its operators
# defect: the operand test of an operator reads engine errors only, so an operand marked as an error is handed to its type, which declines it
# caught by: the contamination test (testCustom_ops)
#
--- a/src/vm/custom.c
+++ b/src/vm/custom.c
@@ -504,10 +504,10 @@
     // An error operand is the value, and the type is not asked, as a string's
     // `+` gives its error operand (a custom value is never an error, so at
     // most one side is). Equality keeps its rule: it is asked of any pair.
-    if (gltang_vm_stands_for_error(a)) {
+    if (gltang_vm_is_error(a)) { /* planted: engine errors only */
       return a;
     }
-    if (gltang_vm_stands_for_error(b)) {
+    if (gltang_vm_is_error(b)) {
       return b;
     }
   }
