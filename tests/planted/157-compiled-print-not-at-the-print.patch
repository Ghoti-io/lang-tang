# 157 the guest frame of a compiled printer keeps the identity of its last poll
# defect: the print helpers do not set the guest frame's poll identity to the print's own, so the
#   identity a poll inside a long print reads is the interpreter's no longer
# caught by: the large-print test, which compares the identity of every poll (testJit_templates)
#
--- a/src/jit/natives.c
+++ b/src/jit/natives.c
@@ -162,7 +162,7 @@
 static void stand_at_the_op(GLTANG_Execution * exec, void * context) {
   GRCORE_Stack * stack = gltang_jit_stack_of(exec->jit, context);
   GRCORE_FrameRef top = grcore_stack_top(stack);
-  if (top.offset) {
+  if (top.offset && false) {  /* planted: the frame is not stood at the print */
     const uint64_t * slots = grcore_stack_slots(stack, top);
     // A live top frame: the setter cannot refuse it.
     (void)grcore_stack_set_identity(stack, top, (GRCORE_PollIdentity){slots[GLTANG_F_FUNCTION], exec->current_offset, exec->engine});
