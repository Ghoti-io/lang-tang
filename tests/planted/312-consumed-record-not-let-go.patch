# 312 the record a continuation was called from stays on the chain
# defect: the continuation runs and the record is not unlinked, so the next return is delivered to it again
# caught by: the pending-depth checks of the generated operation test and the chained-request log test (only those run: a record left on the chain can loop for ever elsewhere) (testCustom_reentry)
#
--- a/src/vm/custom.c
+++ b/src/vm/custom.c
@@ -678,7 +678,7 @@
     *early = MAKE_ERROR(GLTANG_ERROR_HOST_FAILED);
     return true;
   }
-  stage->pop = true;
+  stage->pop = false;
   stage->index = record->continuation;
   stage->state = record->slots[GLTANG_PENDING_STATE];
   stage->result = record->slots[GLTANG_PENDING_RESULT];
