# 73 the exit that boxes a raw float counts toward the discard limit
# defect: the deopt hook counts a designed exit (a raw float boxed for its consumer)
# like a failure, as the first float story did, so a float-returning function with a
# loop is let go at the eighth call
# caught by: the looped float-returner that must stay compiled across fourteen calls
# (testJit_arith)
#
--- a/src/jit/hooks.c
+++ b/src/jit/hooks.c
@@ -338,8 +338,7 @@
           // The designed exit: a raw float is boxed for its consumer. Not a failure of compiled
           // code, so it does not count toward the discard limit (and is counted, with the
           // others, by the entry once the rebuild has succeeded).
-          expected = true;
-          counts = false;
+          expected = true;  /* planted: and it counts */
         }
         else if (native_site_at(jc, fr.identity.offset)) {
           // An exit at a native call (a library call, a member load, a value operation):
