# 287 the bytes pointer's pin is not let go when the callback's scope closes
# defect: scope close forgets its pins without unpinning them, so the instance stays pinned for ever
# caught by: the pin count after the bytes-pointer callbacks (testCustom_collector)
#
--- a/src/vm/handle.c
+++ b/src/vm/handle.c
@@ -128,9 +128,7 @@
   }
   GLTANG_Execution * exec = call->exec;
   GLTANG_HandleState * hs = exec->handles;
-  if (__builtin_expect(hs->pin_count != 0, 0)) {
-    unpin_scope(exec, hs, call->scope);
-  }
+  /* planted: the pins are not let go */
   if (hs->frame_count > call->frame_floor) {
     gltang_vm_temp_release(exec, hs->frames[call->frame_floor].base);
     hs->frame_count = call->frame_floor;
