# 27 a native's arguments are read before the collection and not pinned
# defect: the wrapper copies the callee and the arguments into its frame before its
# record is open and gives the record a segment that does not contain the copies, so
# a moving collector does not see them: what they name moves and the native reads the
# old place (the operand stack, the other holder, is updated; the copy is not)
# caught by: the relocation arm only, where a native that allocates reads its argument
# afterwards (testNative_calls, GRHEAP_RELOCATE+TORTURE)
#
--- a/src/vm/vm_internal.h
+++ b/src/vm/vm_internal.h
@@ -819,7 +819,9 @@
 static inline uintptr_t gltang_vm_segment_low(uintptr_t frame, const void * copies) {
   uintptr_t low = frame - 512u;
   uintptr_t at = (uintptr_t)copies;
-  return at < low && frame - at <= 4096u ? at - 64u : low;
+  (void)low;
+  (void)at;
+  return frame + 8u;  /* planted: the segment starts above the copies */
 }
 
 /** @brief The value of a call whose record was refused (the native-depth budget, or the memory budget). */
